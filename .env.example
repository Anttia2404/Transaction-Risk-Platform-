# Local development only. Replace before using outside a disposable local environment.
POSTGRES_DB=transaction_risk
POSTGRES_USER=transaction_risk
POSTGRES_PASSWORD=local_dev_only_change_me
DB_URL=jdbc:postgresql://localhost:5433/transaction_risk
DB_USERNAME=transaction_risk
DB_PASSWORD=local_dev_only_change_me

# Generate a random 32-byte value and Base64-encode it. Never reuse this example.
JWT_SECRET=
JWT_ISSUER=transaction-risk-platform
JWT_EXPIRY_SECONDS=900

# Local-profile user seed is disabled unless explicitly enabled.
LOCAL_USER_SEED_ENABLED=false
LOCAL_USER_SEED_USERNAME=
LOCAL_USER_SEED_PASSWORD=
LOCAL_USER_SEED_ROLE=ADMIN
